{
  "$schema":  "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": ["nodejs@22"],
  "shell": {
    "init_hook": [
      "devbox run assets:init"
    ],
    "scripts": {
      "assets:init": "yarn",
      "assets:build": "yarn build"
    }
  },
  "env": {
    "DEVBOX_COREPACK_ENABLED": "1"
  }
}
